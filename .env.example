# PostgreSQL
POSTGRES_DB=medidoc
POSTGRES_USER=medidoc
POSTGRES_PASSWORD=medidoc_dev_password
POSTGRES_PORT=5432

# JWT — lokal beliebig, siehe docs/auth-api.md. Kein Default im Code:
# ein Secret, das man vergessen kann zu setzen, ist keins.
# Mindestens 32 Zeichen, sonst warnt PyJWT (RFC 7518). Echtes Secret erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_ALGORITHM und JWT_EXPIRE_MINUTES stehen bewusst nicht hier: beide haben
# einen Default in app/core/config.py, eine zweite Kopie koennte nur veralten.
JWT_SECRET=dev_only_change_me_mindestens_32_zeichen_lang

# Startbenutzer fuer den Seed (python -m app.seed), siehe docs/auth-api.md.
# Reine Testzugangsdaten, kein Deployment-Stand.
SEED_ADMIN_EMAIL=anna.admin@medidoc.test
SEED_ADMIN_PASSWORD=geheim123
SEED_STAFF_EMAIL=tom.staff@medidoc.test
SEED_STAFF_PASSWORD=geheim123

# Frontend-Origin fuer CORS, kommagetrennt
CORS_ORIGINS=http://localhost:5173

# Frontend — VITE_API_URL wird vom Browser aufgerufen und muss daher von ausserhalb
# des Compose-Netzes erreichbar sein.
VITE_API_URL=http://localhost:8000
# Kommagetrennte Hostnamen, die der Vite-Entwicklungsserver akzeptiert.
VITE_ALLOWED_HOST=localhost
FRONTEND_PORT=5173
# Logging und Monitoring — siehe docs/logging-monitoring.md
LOG_LEVEL=INFO
# false: lesbare Zeilen fuers Terminal. true: eine JSON-Zeile pro Ereignis.
LOG_JSON=false

# MongoDB fuer den Audit-Trail und die Angaben zu den Dokumenten. Bewusst LEER:
# Docker Compose setzt die URL selbst (mongodb://mongo:27017), und die CI
# kopiert diese Datei nach .env — stuende hier ein Host, der dort nicht
# existiert, liefe jeder Testlauf in Verbindungs-Timeouts.
#
# Leer heisst: Trail im Speicher, nach Neustart weg — und die Dokument-
# Endpunkte antworten mit 500. Fuer die Dokumente gibt es keinen Rueckfall in
# den Speicher, siehe ADR-0007 (Nachtrag Sprint 2). Wer das Backend lokal ohne
# Compose startet und Dokumente braucht, setzt hier mongodb://localhost:27017.
MONGO_URL=
MONGO_DB=medidoc
MONGO_DB_PORT=27017
# Bind-Adresse der veröffentlichten Datenbankports. Lokal bleibt der Zugriff von
# ausserhalb möglich; im AWS-Bootstrap wird sie auf 127.0.0.1 beschränkt.
DB_BIND_IP=0.0.0.0
AUDIT_RETENTION_DAYS=30

# Schwellen der Missbrauchserkennung. Es wird nur erkannt und protokolliert,
# nie blockiert. Zum Vorfuehren ruhig kleiner drehen.
ABUSE_WINDOW_MINUTES=15
ABUSE_FAILED_LOGINS_PER_EMAIL=5
ABUSE_FAILED_LOGINS_PER_IP=10
ABUSE_REJECTED_TOKENS_PER_IP=10
ABUSE_FORBIDDEN_PER_USER=3
ABUSE_NOT_FOUND_PER_USER=20

# Dokumente — siehe docs/documents-api.md
# Wohin die Anhaenge geschrieben werden. Nur die Bytes liegen hier; die Angaben
# zum Dokument stehen in MongoDB (ADR-0002). Leer lassen heisst: Ordner
# "uploads" im Repo-Wurzelverzeichnis. Docker Compose setzt /data/uploads auf
# einem eigenen Volume.
UPLOAD_DIR=
# 20 MB je Anhang. Wird beim Schreiben geprueft, nicht danach.
MAX_UPLOAD_BYTES=20971520
